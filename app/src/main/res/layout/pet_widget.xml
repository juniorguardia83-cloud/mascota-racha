 android:orientation="vertical" android:gravity="center" android:padding="12dp"
 android:background="@drawable/widget_bg">
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:text="💗 MimoPets" android:textStyle="bold" android:textSize="15sp" android:textColor="#57366F"/>
 <TextView android:id="@+id/widget_pet" android:layout_width="wrap_content" android:layout_height="wrap_content"
