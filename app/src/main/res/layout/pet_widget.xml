<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:gravity="center_vertical" android:padding="14dp"
 android:background="@drawable/widget_bg">
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:text="✿ MI PEQUEÑO COMPAÑERO" android:textStyle="bold" android:textSize="10sp" android:letterSpacing="0.06" android:textColor="#47794B"/>
 <TextView android:id="@+id/widget_pet" android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:text="🐶 Perrito" android:textSize="25sp" android:textStyle="bold" android:textColor="#365C42" android:paddingTop="4dp"/>
 <TextView android:id="@+id/widget_stats" android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:text="🔥 0 días  ·  🪙 0" android:textSize="13sp" android:textStyle="bold" android:textColor="#8B6680" android:paddingTop="3dp"/>
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:text="Toca aquí para cuidar a tu mascota  ✨" android:textSize="10sp" android:textColor="#66846A" android:paddingTop="5dp"/>
</LinearLayout>